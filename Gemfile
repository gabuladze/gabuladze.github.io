source "https://rubygems.org"

# GitHub Pages builds this site with its own pinned toolchain and never reads
# this file. It exists so `bundle exec jekyll serve` works locally against the
# same gem versions Pages uses.
gem "github-pages", group: :jekyll_plugins

# Required to run `jekyll serve` on Ruby 3.x, which dropped webrick from stdlib.
gem "webrick", "~> 1.8"
